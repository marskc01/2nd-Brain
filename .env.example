# Public application configuration (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://dgbrxgkktdqjymjmnrzr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/worker only. Never prefix these with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_USER_ID=
OWNER_INSTAGRAM_ID=
# Instagram Login: use the Instagram app secret from Instagram API setup.
# Verified against a Meta dashboard test; the parent Basic-settings secret failed.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Exact, comma-separated direct-media CDN hosts confirmed against a live payload.
# Empty means remote media retrieval is disabled. Shared Reel URLs are not scraped.
META_MEDIA_HOSTS=
# Reserved for future OAuth/reply integration; no reply executor currently enabled.
META_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
# whisper-1 is required for the current segment-timestamp adapter.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
APP_URL=http://localhost:3000
# Estimated reservations, not reconciled invoices. Daily reset: 00:00 UTC.
ATTEMPT_RESERVATION_USD=0.5
DAILY_BUDGET_USD=5
CAPTURE_BUDGET_USD=2
NEXT_TELEMETRY_DISABLED=1
